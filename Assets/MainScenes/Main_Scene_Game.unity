    - target: {fileID: 1845934897413890013, guid: fad4957d8e1bdf24cbdc8c59ec7a5d55, type: 3}
      propertyPath: allChoices.Array.data[0].description
      value: "\uBCF4\uB108\uC2A4 \uB9F5\uC758 \uCE69\uC0B0\uC758 \uC810\uC218\uB97C
        5\uBC30\uB85C \uB298\uB9BD\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 1845934897413890013, guid: fad4957d8e1bdf24cbdc8c59ec7a5d55, type: 3}
      propertyPath: allChoices.Array.data[1].description
      value: "\uBCF4\uB108\uC2A4 \uB9F5\uC5D0 \uC788\uB294 \uCE69\uC0B0\uC758 \uBC18\uBC1C\uB825\uC744
        \uB298\uB9BD\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 1845934897413890013, guid: fad4957d8e1bdf24cbdc8c59ec7a5d55, type: 3}
      propertyPath: allChoices.Array.data[2].description
      value: "\uBCF4\uB108\uC2A4 \uB9F5 \uC544\uB798 \uC601\uC5ED\uC758 \uBC30\uC218\uB97C
        3\uBC30\uB85C \uB298\uB9BD\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 1845934897413890013, guid: fad4957d8e1bdf24cbdc8c59ec7a5d55, type: 3}
      propertyPath: allChoices.Array.data[3].description
      value: "\uBCF4\uB108\uC2A4 \uB9F5\uC5D0 \uD669\uAE08 \uCE69\uC0B0\uC774 \uCD94\uAC00\uB420
        \uD655\uB960\uC744 \uB192\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 1845934897413890013, guid: fad4957d8e1bdf24cbdc8c59ec7a5d55, type: 3}
      propertyPath: allChoices.Array.data[4].description
      value: "\uBAA8\uB4E0 \uC810\uC218\uD68D\uB4DD\uC774 20% \uC0C1\uC2B9\uD569\uB2C8\uB2E4!"
      objectReference: {fileID: 0}
    - target: {fileID: 1845934897413890013, guid: fad4957d8e1bdf24cbdc8c59ec7a5d55, type: 3}
      propertyPath: allChoices.Array.data[5].description
      value: "\uC81C\uC5B4\uD560\uC218 \uC5C6\uB294 \uB2F9\uC2E0\uC758 \uBE44\uC7A5\uC758
        \uBB34\uAE30\uB97C \uD65C\uC131\uD654\uD569\uB2C8\uB2E4!"
      objectReference: {fileID: 0}
    - target: {fileID: 1845934897413890013, guid: fad4957d8e1bdf24cbdc8c59ec7a5d55, type: 3}
      propertyPath: allChoices.Array.data[6].description
      value: "\uD50C\uB9AC\uD37C\uC758 \uC0AC\uC6A9\uD69F\uC218\uB97C 5 \uB298\uB9BD\uB2C8\uB2E4."
