  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueTable_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: f392510f32186a740ab579272878b571, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 39477317632
    m_Localized: "\u2026zzzz\uCE58\uC9C0\uC9C1.. \uC5B4\uC774! \uAC70\uAE30! \uC815\uC2E0\uC774
      \uC880 \uB4E4\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900544
    m_Localized: "\uB208\uC740 \uB5A0\uC11C \uB2E4\uD589\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900545
    m_Localized: "\uBA4D\uD558\uB2C8 \uD654\uBA74 \uBC16\uB9CC \uCCD0\uB2E4\uBCF4\uACE0
      \uC788\uAE38\uB798 \uC2DC\uC2A4\uD15C \uC624\uB958 \uB09C \uC904 \uC54C\uC558\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900546
    m_Localized: "\uB09C \uC774\uACF3\uC758 \uC810\uC218\uB97C '\uAD00\uB9AC'\uD558\uB294
      \uB51C\uB7EC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900547
    m_Localized: "\uB10C \uADF8\uB0E5 \uACF5\uC774\uB098 \uD295\uAE30\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900548
    m_Localized: "\uC810\uC218\uB294 \uB0B4\uAC00 \uC54C\uC544\uC11C \uCC59\uAE38
      \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900549
    m_Localized: "\uC774 \uBC14\uB2E5 \uB8F0 \uBAB0\uB77C? \uB124\uAC00 \uC544\uBB34\uB9AC
      \uC810\uC218\uB97C \uB0B4\uB3C4 \uB0B4 '\uC2B9\uC778'\uC774 \uC5C6\uC73C\uBA74
      \uADF8\uB0E5 0\uC77C \uBFD0\uC774\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900550
    m_Localized: "\uADF8\uB7EC\uB2C8\uAE4C... \uBF40\uCC0C \uC880 \uCC59\uAE30\uC790\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900551
    m_Localized: "\uBB50, \uC815 \uC5B5\uC6B8\uD558\uBA74... \uC5EC\uAE30\uC11C 3\uB77C\uC6B4\uB4DC\uAE4C\uC9C0
      \uB3C4\uB2EC\uD574 \uBCF4\uC2DC\uB4E0\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900552
    m_Localized: "\uADF8\uB7FC '\uC804\uC561' \uB108\uD55C\uD14C \uC8FC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900553
    m_Localized: "\uC2DC\uAC04 \uC5C6\uC5B4! [\uD654\uBA74] \uC544\uBB34 \uB370\uB098
      \uD074\uB9AD\uD574\uC11C \uC2DC\uC791\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900554
    m_Localized: "\uC2A4\uD398\uC774\uC2A4\uBC14\uB97C \uB204\uB974\uBA74 \uACF5\uC774
      \uBC1C\uC0AC\uB418\uB294\uAC70 \uC78A\uC9C0 \uB9D0\uB77C\uACE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900555
    m_Localized: "\uC624~ \uC81C\uBC95\uC778\uB370? \uC190\uAC00\uB77D\uC774 \uC544\uC8FC
      \uD604\uB780\uD574?"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900556
    m_Localized: "\uC88B\uC544, \uC88B\uC544! \uC774 \uC815\uB3C4\uBA74 1\uCC28 \uC218\uC218\uB8CC\uB294
      \uCC59\uACBC\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900557
    m_Localized: "\uBB50? 2\uB77C\uC6B4\uB4DC\uAE4C\uC9C0... \uD074\uB9AC\uC5B4 \uD588\uB2E4\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900558
    m_Localized: "...\uD760. \uC774\uAC8C... \uB418\uB124?"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900559
    m_Localized: "\uC790, \uC790! \uB9C8\uC9C0\uB9C9 3\uB77C\uC6B4\uB4DC\uB2E4! (\uC808\uB300
      \uBABB \uAE68\uACA0\uC9C0)"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900560
    m_Localized: "!! 3... 3\uB77C\uC6B4\uB4DC\uB97C... \uAE7C\uB2E4\uACE0?! \uB9D0\uB3C4
      \uC548 \uB3FC!!"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900561
    m_Localized: "\uC9C4\uC9DC\uB85C \uAE30\uACC4\uB97C \uACE0\uC7A5 \uB0C8\uC796\uC544!
      \uC2DC\uC2A4\uD15C \uBD95\uAD34 \uC2DC\uC791\uB41C\uB2E4\uACE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900562
    m_Localized: "\uC774\uB7F0 \uC820\uC7A5! \uB0B4 \uB3C8!!!! \uB0B4 \uBF40\uCC0C!!!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900563
    m_Localized: "\uC544... \uC774\uB7F4 \uC2DC\uAC04\uC774 \uC5C6\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900564
    m_Localized: "\uB370\uC774\uD130 \uC804\uC1A1 \uC54C\uBC14 \uC788\uC5C8\uB358
      \uAC78 \uAE4C\uBA39\uC5C8\uB124~~"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900565
    m_Localized: 20000!
    m_Metadata:
      m_Items: []
  - m_Id: 39489900566
    m_Localized: "\uC5B4\uC774\uCFE0. \uC800\uB7F0... 'GAME OVER'\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900567
    m_Localized: "\uC544\uAE5D\uB2E4, \uC544\uAE4C\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900568
    m_Localized: "\uADF8\uB807\uAC8C \uD604\uB780\uD558\uAC8C \uC190\uAC00\uB77D
      \uB180\uB9AC\uB354\uB2C8... \uB9C8\uC9C0\uB9C9\uC5D0 \uD798\uC774 \uBE60\uC84C\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900569
    m_Localized: "\uAD1C\uCC2E\uC544, \uAD1C\uCC2E\uC544. \u2026 \uB0B4 \uB3C8\uC740"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900570
    m_Localized: "\uC544\uB2C8, \uCC38\uAC00\uBE44\uB294 \uB0B4\uAC00 \uC798 \uBCF4\uAD00\uD558\uACE0
      \uC788\uC744 \uD14C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 39489900571
    m_Localized: "\uB124 '\uBA85\uC608' \uD68C\uBCF5\uD560 \uAE30\uD68C\uB294 \uD55C
      \uBC88 \uB354 \uC904\uAC8C!"
    m_Metadata:
      m_Items: []
  - m_Id: 39494094848
    m_Localized: "\uC5B4\uB514 \uB364\uBCBC\uBCF4\uB77C\uACE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204662378496
    m_Localized: "\uC5B4\uC774\uAD6C, \uD45C\uC815\uC744 \uBCF4\uC544\uD558\uB2C8
      \uC774 \uBC14\uB2E5\uC774 \uCC98\uC74C\uC778 \uBAA8\uC591\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515840
    m_Localized: "\uB0B4 \uC18C\uC911\uD55C \uBC25\uC904... \uC544\uB2C8, \uAE30\uACC4\uB97C
      \uB9DD\uAC00\uB728\uB9AC\uBA74 \uC548 \uB418\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515841
    m_Localized: "\uD2B9\uBCC4\uD788 \uAE30\uBCF8 \uB8F0\uC744 \uC544\uC8FC '\uCE5C\uC808\uD558\uAC8C'
      \uC54C\uB824\uC8FC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515842
    m_Localized: "\uC798 \uB4E4\uC5B4. \uD50C\uB9AC\uD37C\uB85C \uACF5\uC744 \uD295\uACA8\uC11C
      \uC704\uB85C \uC62C\uB9AC\uACE0, \uC810\uC218\uB97C \uAE01\uC5B4\uBAA8\uC73C\uB294
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515843
    m_Localized: "\uBB3C\uB860 \uC810\uC218\uC758 \uC77C\uBD80\uB294 \uB0B4 '\uC218\uC218\uB8CC'\uB85C
      \uB5A8\uC5B4\uC9C0\uACA0\uC9C0\uB9CC~"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515844
    m_Localized: "\uC774\uC81C \uD654\uBA74\uC5D0 \uB098\uC624\uB294 \uC548\uB0B4\uB97C
      \uC798 \uB530\uB77C \uD574\uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515845
    m_Localized: "\uC2DC\uAC04 \uB04C\uC9C0 \uB9C8! \uB0B4 \uC2DC\uAC04\uC740 \uACE7
      \uB3C8\uC774\uB77C\uACE0!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
