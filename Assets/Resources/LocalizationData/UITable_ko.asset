  m_TableData:
  - m_Id: 14400438669312
    m_Localized: "로비 BGM 음량"
    m_Metadata:
      m_Items: []
  - m_Id: 14400438669313
    m_Localized: "게임BGM 음량"
    m_Metadata:
      m_Items: []
  - m_Id: 12374166212608
    m_Localized: "효과음 음량"
    m_Metadata:
      m_Items: []
  - m_Id: 12374166212609
    m_Localized: "이펙트 효과"
    m_Metadata:
      m_Items: []
  - m_Id: 12374166212610
    m_Localized: "언어 (Language)"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406912
    m_Localized: "해상도"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406913
    m_Localized: "전체화면 창모드"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406914
    m_Localized: "기본 조작"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406915
    m_Localized: "[A] [D] - 좌우 공 움직임"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406916
    m_Localized: "[Z] [/] - 왼쪽 / 오른쪽 플리퍼"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406917
    m_Localized: "[스페이스바] - 공 쏘아 올리기"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406918
    m_Localized: "[좌클릭] - 로그라이크 선택"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406919
    m_Localized: "제한 사항 표시"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406920
    m_Localized: "공의 목숨 횟수"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406921
    m_Localized: "공을 칠 수 있는 횟수"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406922
    m_Localized: "기본조작법을 알려주겠습니다"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406923
    m_Localized: "[Z]와 [/]를 각각 눌러보세요."
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406924
    m_Localized: "장애물 5개를 맞추면 2층 입장 가능! 아무키나 눌러서 계속..."
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406925
    m_Localized: "Spacebar를 눌러 공을 발사하세요!"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406926
    m_Localized: "선택지를 눌러 강화를 해보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406927
    m_Localized: "목표점수에 도달했습니다! 이제 게임을 시작해보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000001
    m_Localized: "목표 {0:N0}점 달성!\n최고 기록에 도전해 봐!"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000002
    m_Localized: "게임 오버 · 공을 모두 사용했어요"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000003
    m_Localized: "게임 오버 · 플리퍼 횟수 소진 후 공이 빠졌어요"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000004
    m_Localized: "최종 {0:N0}점 · 목표 {1:N0}점 달성"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000005
    m_Localized: "목표 미달 · {0:N0} / {1:N0}점 ({2:N0}점 부족)"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000006
    m_Localized: "클리어 · 기록 도전 종료 (공 소진)"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000007
    m_Localized: "클리어 · 기록 도전 종료 (플리퍼 횟수 소진)"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000000
    m_Localized: "이펙트 세부 설정"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000001
    m_Localized: "원하는 효과만 켜거나, 관련 효과를 한 번에 끌 수 있습니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000002
    m_Localized: "기본 모드 · 모두 켜기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000003
    m_Localized: "광과민성 배려 · 모두 끄기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000004
    m_Localized: "기본 모드 · 모든 효과 ON"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000005
    m_Localized: "광과민성 배려 · 모든 효과 OFF"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000006
    m_Localized: "사용자 설정 · 선택한 효과만 ON"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000007
    m_Localized: "카메라 흔들림"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000008
    m_Localized: "충돌·폭죽 파티클"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000009
    m_Localized: "공 궤적"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000010
    m_Localized: "섬광·효과 조명"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000011
    m_Localized: "글리치·화면 움직임"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000012
    m_Localized: "빛 번짐·후처리"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000013
    m_Localized: "설정으로 돌아가기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000014
    m_Localized: "일부"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000015
    m_Localized: "세부 설정"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000016
    m_Localized: "전체화면"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000017
    m_Localized: "테두리 없는 창모드"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000018
    m_Localized: "창모드"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000019
    m_Localized: "시스템 설정"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000020
    m_Localized: "게임 설명\n핀볼(1층)에서 점수를 올리고, 조건을 달성하면 2층으로 진입할 수 있어요.\n아무 키나 눌러 계속…"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000021
    m_Localized: "{0}와 {1}를 각각 눌러보세요!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000022
    m_Localized: "장애물 5개를 맞추면 2층 입장 가능!\n아무 키나 눌러 계속…"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000023
    m_Localized: "Space를 눌러 공을 발사하세요!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000024
    m_Localized: "완료"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000025
    m_Localized: "눌러보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000026
    m_Localized: "{0}점을 달성하세요!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000027
    m_Localized: "목표 점수 달성!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000028
    m_Localized: "{0}\n{1}: {2} / {3}: {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000029
    m_Localized: "튜토리얼 완료!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000030
    m_Localized: "{0}점 달성과 양쪽 플리퍼 연습 완료!\n로비로 돌아가거나 바로 게임을 시작해보세요."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000031
    m_Localized: "다시 해볼까요?"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000032
    m_Localized: "{0}점에 도달하기 전에 공이 빠졌어요.\n다시 도전해보세요!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000033
    m_Localized: "공을 발사한 뒤 {0}와 {1} 플리퍼를 각각 한 번 사용해보세요!\n목표 점수와 플리퍼 연습을 마치면 튜토리얼이 완료돼요."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000034
    m_Localized: "게임 시작"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000035
    m_Localized: "튜토리얼"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000036
    m_Localized: "다시 하기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000037
    m_Localized: "로비로 가기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000038
    m_Localized: "기록 보기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000039
    m_Localized: "새로고침"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000040
    m_Localized: "다시 뽑기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000041
    m_Localized: "건너뛰기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000042
    m_Localized: "게임 종료하기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000043
    m_Localized: "확인"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000044
    m_Localized: "취소"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000045
    m_Localized: "닫기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000046
    m_Localized: "게임을 종료하시겠습니까?"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000047
    m_Localized: "점수: "
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000048
    m_Localized: "라운드 "
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000049
    m_Localized: "남은 공: "
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000050
    m_Localized: "플리퍼 횟수: "
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000051
    m_Localized: "횟수"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000052
    m_Localized: "선택지"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000053
    m_Localized: "진행 목표"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000054
    m_Localized: "1층 안전장치 타격"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000055
    m_Localized: "블랙홀 생성 타격"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000056
    m_Localized: "2층 진입용 LED 범퍼 타격"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000057
    m_Localized: "보조 발사대 재활성화 스위치"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000058
    m_Localized: "2층 코인 생성 타격"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000059
    m_Localized: "생성"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000060
    m_Localized: "분"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000061
    m_Localized: "초"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000062
    m_Localized: "최고 기록"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000063
    m_Localized: "최고 기록"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000064
    m_Localized: "순위:"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000065
    m_Localized: "순위        이름       점수"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000066
    m_Localized: "이름                    점수"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000067
    m_Localized: "기록 저장 대기 중"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000068
    m_Localized: "기록 저장 중…"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000069
    m_Localized: "내 점수: {0:N0}\n내 순위: #{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000070
    m_Localized: "기록을 저장하지 못했어요. 다시 시도해주세요."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000071
    m_Localized: "닉네임: "
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000072
    m_Localized: "닉네임을 입력하세요"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000073
    m_Localized: "문자와 숫자로 8글자까지 입력할 수 있어요."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000074
    m_Localized: "Steam을 실행하고 로그인해주세요"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000075
    m_Localized: "{0}회"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000076
    m_Localized: "일반"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000077
    m_Localized: "보통"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000078
    m_Localized: "희귀"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000079
    m_Localized: "영웅"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000080
    m_Localized: "전설"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000081
    m_Localized: "보너스 맵 점수 강화"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000082
    m_Localized: "보너스 맵의 칩산 점수를 5배로 늘립니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000083
    m_Localized: "칩산 반발력 강화"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000084
    m_Localized: "보너스 맵 칩산의 반발력을 늘립니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000085
    m_Localized: "보너스 배율 강화"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000086
    m_Localized: "보너스 맵 아래 영역의 배율을 3배로 늘립니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000087
    m_Localized: "황금 칩산의 기회"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000088
    m_Localized: "보너스 맵에 황금 칩산이 추가될 확률을 높입니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000089
    m_Localized: "점수 배수 추가!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000090
    m_Localized: "모든 점수 획득이 20% 증가합니다!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000091
    m_Localized: "리스크 있는 무기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000092
    m_Localized: "제어할 수 없는 비장의 무기를 활성화합니다!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000093
    m_Localized: "보충의 시간"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000094
    m_Localized: "플리퍼의 사용 횟수를 5 늘립니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000095
    m_Localized: "2층 출입 허가증"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000096
    m_Localized: "조건 없이 2층으로 진입할 수 있습니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000097
    m_Localized: "딜러의 자비"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000098
    m_Localized: "공 기회를 2회 더 얻습니다.\n라운드 클리어 시 남은 공은 선택지 선택 횟수에 더해집니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000099
    m_Localized: "세계 랭킹"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000100
    m_Localized: "순위"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000101
    m_Localized: "플레이어"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000102
    m_Localized: "점수"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000103
    m_Localized: "세계 랭킹을 불러오는 중…"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000104
    m_Localized: "새로고침"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000105
    m_Localized: "아직 기록이 없습니다. 첫 기록에 도전하세요!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000106
    m_Localized: "랭킹을 불러오지 못했습니다. 다시 시도해주세요."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000107
    m_Localized: "세계 TOP 10 · 플레이어별 최고 점수"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000108
    m_Localized: "온라인 랭킹은 Steam 버전에서 이용할 수 있습니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000109
    m_Localized: "로비로 돌아가기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000110
    m_Localized: "현재 기록은 사라집니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000111
    m_Localized: "광과민성 주의"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000112
    m_Localized: "이 게임에는 번쩍이는 빛과 빠른 화면 변화가 포함되어 있습니다. 발작 경험이 없는 분에게도 발작이나 불편함을 유발할 수 있습니다.\n\n어지러움, 시야 변화, 근육 경련, 방향 감각 상실 등의 증상이 나타나면 즉시 플레이를 멈추고 의료 전문가와 상담하세요.\n\n본인이나 가족에게 발작 병력이 있다면 플레이하기 전에 의료 전문가와 상담하세요."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000113
    m_Localized: "지금 효과를 줄이거나 나중에 설정에서 조절할 수 있습니다.\n효과를 줄여도 모든 위험이 사라지지는 않습니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000114
    m_Localized: "계속하기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000115
    m_Localized: "효과 줄이고 계속하기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000116
    m_Localized: "종료"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000117
    m_Localized: "데모"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000118
    m_Localized: "3라운드 · 기본 공 2개 · 강화 선택 3회"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000119
    m_Localized: "본편 찜하기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000120
    m_Localized: "충전 {0:N0}/{1:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000121
    m_Localized: "축전기 선택 시 충전"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000122
    m_Localized: "마지막 공 +{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000123
    m_Localized: "마지막 공 보너스 +{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000124
    m_Localized: "마지막 공 강화 선택 시 보너스"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000125
    m_Localized: "강화로 얻은 추가 점수"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000126
    m_Localized: "축전기 +{0:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000127
    m_Localized: "마지막 공 +{0:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000128
    m_Localized: "개인 최고 {0:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000129
    m_Localized: "아직 개인 기록이 없습니다"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000130
    m_Localized: "데모 개인 기록"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000131
    m_Localized: "블랙홀 축전기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000132
    m_Localized: "범퍼 적중마다 100점 충전, 최대 600점. 블랙홀 진입 시 정산합니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000133
    m_Localized: "축전기 II"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000134
    m_Localized: "충전 한도를 1,000점으로 늘립니다. 범퍼 적중당 충전은 100점입니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000135
    m_Localized: "마지막 공 역전"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000136
    m_Localized: "마지막 공의 획득 점수 +50%. 축전기 충전 점수에는 적용되지 않습니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000137
    m_Localized: "마지막 공 II"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000138
    m_Localized: "마지막 공 점수 보너스를 +75%로 높입니다. 충전 점수는 그대로입니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000139
    m_Localized: "공 하나 더"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000140
    m_Localized: "현재 공 +1. 이후 라운드의 기본 공도 1개 늘어납니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000141
    m_Localized: "데모 점수 랭킹"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000142
    m_Localized: "데모 TOP 10 · 본편 기록과 별도로 집계"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000143
    m_Localized: "데모 랭킹은 Steam 로그인 후 확인할 수 있습니다. 개인 최고점은 이 PC에 저장됩니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000144
    m_Localized: "개인 최고점을 이 PC에 저장했습니다. 온라인 랭킹은 갱신되지 않았습니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000145
    m_Localized: "선택 내역 [Tab]"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000201
    m_Localized: "블랙홀 축전기"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000202
    m_Localized: "범퍼마다 100점 충전, 한도 600. 블랙홀에서 배율 없이 정산. 공 소진 시 미정산 충전 소실. 마지막 공 전략 보유 시 마지막 공에서 200점씩 충전."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000203
    m_Localized: "축전기 II"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000204
    m_Localized: "충전 한도 1,000. 범퍼당 100점, 마지막 공 전략 보유 시 마지막 공에서 200점. 공 소진 시 미정산 충전 소실. 블랙홀 정산은 고정 점수. 최대 2단계."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000205
    m_Localized: "마지막 공 역전"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000206
    m_Localized: "마지막 공에서 직접 득점 +50%, 축전기 충전량 2배. 충전 정산·누적 점수 배율에는 미적용. 추가 공을 얻으면 발동이 늦어집니다."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000207
    m_Localized: "마지막 공 II"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000208
    m_Localized: "마지막 공의 직접 득점 보너스 +75%. 축전기 충전량은 2배 유지. 충전 정산·누적 점수 배율에는 미적용. 최대 2단계."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000209
    m_Localized: "점수 배수 추가!"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000210
    m_Localized: "이번 판 직접 득점 +20%. 중복 선택마다 20%p 추가. 공 소진·라운드 전환 후 유지. 충전 정산·누적 총점 곱셈에는 미적용."
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000211
    m_Localized: "충전 {0}/{1} · 적중당 +{2}\n마지막 공 +{3}%\n공 소진 시 미정산 충전 소실"
    m_Metadata:
      m_Items: []
