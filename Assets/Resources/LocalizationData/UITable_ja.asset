    m_Metadata:
      m_Items: []
  - m_Id: 16000000000029
    m_Localized: "チュートリアル完了！"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000030
    m_Localized: "{0}点を達成し、両方のフリッパーも練習できました！\nロビーに戻るか、ゲームを始めましょう。"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000031
    m_Localized: "もう一度挑戦しよう！"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000032
    m_Localized: "{0}点に届く前にボールが落ちてしまいました。\nもう一度挑戦しましょう！"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000033
    m_Localized: "発射した後、{0} と {1} のフリッパーを1回ずつ使いましょう！\n目標スコアと両方の練習を達成すると完了です。"
    m_Metadata:
      m_Items: []
