    m_Metadata:
      m_Items: []
  - m_Id: 12374170406913
    m_Localized: "画面モード"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406914
    m_Localized: "基本操作"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406915
    m_Localized: "[A] [D] - ボールを左右に移動"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406916
    m_Localized: "[Z] [/] - 左右のフリッパー"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406917
    m_Localized: "[Space] - ボールを発射"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406918
    m_Localized: "[左クリック] - 強化を選択"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406919
    m_Localized: "残り回数"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406920
    m_Localized: "ボールの残り回数"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406921
    m_Localized: "フリッパーの残り回数"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406922
    m_Localized: "基本操作を説明します。"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406923
    m_Localized: "[Z] と [/] を押してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406924
    m_Localized: "障害物を5つ倒すと2階へ進めます！\n何かキーを押して続ける…"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406925
    m_Localized: "[Space] を押してボールを発射！"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406926
    m_Localized: "選択肢をクリックして強化しましょう。"
    m_Metadata:
      m_Items: []
  - m_Id: 12374170406927
    m_Localized: "目標スコア達成！ゲームを始めましょう。"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000001
    m_Localized: "目標の{0:N0}点を達成！\nハイスコアに挑戦しよう！"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000002
    m_Localized: "ゲームオーバー · ボールを使い切りました"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000003
    m_Localized: "ゲームオーバー · フリッパーを使い切り、ボールが落ちました"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000004
    m_Localized: "最終スコア {0:N0}点 · 目標 {1:N0}点を達成"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000005
    m_Localized: "目標未達 · {0:N0} / {1:N0}点（あと{2:N0}点）"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000006
    m_Localized: "クリア · 記録挑戦終了（ボール切れ）"
    m_Metadata:
      m_Items: []
  - m_Id: 15000000000007
    m_Localized: "クリア · 記録挑戦終了（フリッパー回数切れ）"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000000
    m_Localized: "視覚効果の詳細設定"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000001
    m_Localized: "効果を個別に選ぶか、まとめてオフにできます。"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000002
    m_Localized: "標準 · すべてオン"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000003
    m_Localized: "光刺激を軽減 · すべてオフ"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000004
    m_Localized: "標準 · すべての効果がオン"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000005
    m_Localized: "光刺激を軽減 · すべての効果がオフ"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000006
    m_Localized: "カスタム · 選んだ効果のみオン"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000007
    m_Localized: "カメラの揺れ"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000008
