    m_Metadata:
      m_Items: []
  - m_Id: 16000000000022
    m_Localized: "障害物を5つ倒すと2階へ進めます！\n何かキーを押して続ける…"
    m_Metadata:
      m_Items: []
  - m_Id: 16000000000023
    m_Localized: "Spaceを押してボールを発射！"
    m_Metadata:
      m_Items: []
