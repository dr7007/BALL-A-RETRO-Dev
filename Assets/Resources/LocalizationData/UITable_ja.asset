    m_Metadata:
      m_Items: []
  - m_Id: 16000000000020
    m_Localized: "遊び方\n1階のピンボールで得点し、条件を満たすと2階へ進めます。\n何かキーを押して続ける…"
    m_Metadata:
      m_Items: []
