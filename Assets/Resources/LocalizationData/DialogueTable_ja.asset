--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueTable_ja
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja
  m_SharedData: {fileID: 11400000, guid: f392510f32186a740ab579272878b571, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 39477317632
    m_Localized: "…ジジジッ…おい！そこのお前！気がついたか？"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900544
    m_Localized: "目が覚めてよかったぜ。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900545
    m_Localized: "ぼーっと画面の外ばかり見てるから、システムが故障したのかと思ったぞ。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900546
    m_Localized: "俺はここのスコアを「管理」しているディーラーだ。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900547
    m_Localized: "お前はボールを弾いていればいい。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900548
    m_Localized: "スコアは俺がうまく処理してやるからな。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900549
    m_Localized: "ここのルールを知らないのか？いくら稼いでも、俺の「承認」がなけりゃゼロなんだよ。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900550
    m_Localized: "だからさ…俺にも少し分け前をくれよ。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900551
    m_Localized: "まあ、納得できないなら…3ラウンドまでたどり着いてみな。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900552
    m_Localized: "そしたら「全額」くれてやるよ。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900553
    m_Localized: "時間がない！［画面］のどこかをクリックして始めろ！"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900554
    m_Localized: "Spaceを押せばボールが発射されるぞ。忘れるなよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900555
    m_Localized: "おお、なかなかやるな！指がよく動くじゃないか。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900556
    m_Localized: "よしよし！これで最初の手数料は確保できたな。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900557
    m_Localized: "何だって？2ラウンドまで…クリアしたのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900558
    m_Localized: "…ふむ。そんなことが…できるのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900559
    m_Localized: "さあさあ！最後の第3ラウンドだ！（さすがに無理だろ）"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900560
    m_Localized: "！！だ、第3ラウンドを…クリアしただと？！あり得ない！！"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900561
    m_Localized: "本当に機械を壊しちまった！システムが崩壊するぞ！"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900562
    m_Localized: "くそっ！俺の金が！！俺の取り分が！！"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900563
    m_Localized: "あっ…こんなことをしてる場合じゃない！"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900564
    m_Localized: "データ転送のバイトがあったのを忘れてたぜ～"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900565
    m_Localized: "じゃあな！"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900566
    m_Localized: "おっと、残念…「ゲームオーバー」だな。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900567
    m_Localized: "惜しかったなあ、本当に。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900568
    m_Localized: "あんなに派手に指を動かしてたのに…最後は力尽きたのか？"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900569
    m_Localized: "大丈夫、大丈夫。…俺の金は"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900570
    m_Localized: "いや、参加費は俺がしっかり預かっておくからな。"
    m_Metadata:
      m_Items: []
  - m_Id: 39489900571
    m_Localized: "お前の「名誉」を取り戻すチャンスを、もう一度やるよ！"
    m_Metadata:
      m_Items: []
  - m_Id: 39494094848
    m_Localized: "かかってこい！"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204662378496
    m_Localized: "おや、その顔…ここは初めてみたいだな。"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515840
    m_Localized: "俺の大事な飯の種…いや、機械を壊されちゃ困るからな。"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515841
    m_Localized: "特別に基本ルールを「親切に」教えてやるよ。"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515842
    m_Localized: "よく聞け。フリッパーでボールを上へ弾いて、スコアを稼ぐんだ。"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515843
    m_Localized: "もちろん、その一部は俺の「手数料」になるけどな～"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515844
    m_Localized: "あとは画面の案内に従ってやってみな。"
    m_Metadata:
      m_Items: []
  - m_Id: 25408204708515845
    m_Localized: "もたもたするな！俺の時間は金なんだ！"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
